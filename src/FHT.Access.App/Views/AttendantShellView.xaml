<UserControl x:Class="FHT.Access.App.Views.AttendantShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FHT.Access.App.Views"
             Background="#000000">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />

        <Style x:Key="PrimaryGreenButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Background" Value="#2ECC71" />
            <Setter Property="Foreground" Value="#04150C" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="MinWidth" Value="160" />
        </Style>

        <Style x:Key="DashboardButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Background" Value="#161616" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="20,18" />
            <Setter Property="MinWidth" Value="240" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="DashboardButtonHighlight" TargetType="Button" BasedOn="{StaticResource DashboardButton}">
            <Setter Property="Background" Value="#F15A29" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ScreenPanel" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style x:Key="DashActionButton" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="12" Padding="16,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#1B7A4A" Offset="0" />
                                    <GradientStop Color="#145C38" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.92" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="#0B0B0B" Height="84">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Screen}" Value="AttendantLogin">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Screen}" Value="AttendantDashboard">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Screen}" Value="MemberSearch">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Screen}" Value="Enrollment">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                <Image Source="pack://application:,,,/Assets/logo-fht-acesso.png"
                       Height="40"
                       MaxWidth="150"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <Rectangle Width="1" Height="34" Fill="#333333" Margin="20,0" />
                <TextBlock Text="{Binding ScreenTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Button Content="Encerrar atendimento"
                    Command="{Binding EndAttendanceCommand}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,24,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Screen}" Value="AttendantLogin">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Screen}" Value="AttendantDashboard">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Screen}" Value="MemberSearch">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Screen}" Value="Enrollment">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="24">

            <!-- login / dashboard / busca / cadastro facial moved to full-screen overlay -->

            <!-- ============ ENROLLMENT COMPLETED ============ -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid" BasedOn="{StaticResource ScreenPanel}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Screen}" Value="EnrollmentCompleted">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="120" Height="120" HorizontalAlignment="Center">
                        <Ellipse Width="120" Height="120" Stroke="#2ECC71" StrokeThickness="3" Fill="#0C2018" />
                        <Path Stroke="#2ECC71" StrokeThickness="8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 34,62 L 52,80 L 88,42" />
                    </Grid>

                    <TextBlock Text="{Binding EnrollStatus}"
                               FontSize="22"
                               Foreground="White"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="420"
                               HorizontalAlignment="Center"
                               Margin="0,24,0,24" />

                    <TextBlock Text="{Binding ReleaseStatus}"
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Ir para o totem"
                                Style="{StaticResource PrimaryGreenButton}"
                                Command="{Binding ReturnToKioskCommand}" />
                        <Button Content="Liberar entrada agora"
                                Style="{StaticResource QuietButton}"
                                Command="{Binding ReleaseNowCommand}"
                                Margin="12,0,0,8" />
                        <Button Content="Cadastrar outro"
                                Style="{StaticResource QuietButton}"
                                Command="{Binding EnrollAnotherCommand}"
                                Margin="4,0,0,8" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ============ MANUAL RELEASE ============ -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid" BasedOn="{StaticResource ScreenPanel}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Screen}" Value="ManualRelease">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Background="#101010"
                        BorderBrush="#242424"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="36,32"
                        Width="520"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Liberação manual"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                        <TextBlock Text="{Binding SelectedMemberName}"
                                   FontSize="16"
                                   Foreground="#F15A29"
                                   Margin="0,6,0,24" />

                        <TextBlock Text="Motivo" Style="{StaticResource SectionLabel}" />
                        <ComboBox ItemsSource="{Binding ReasonOptions}"
                                  SelectedItem="{Binding SelectedReason}"
                                  Style="{StaticResource QuietComboBox}"
                                  FontSize="15" />

                        <TextBlock Text="{Binding ReleaseStatus}"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,8,0,16" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Liberar"
                                    Style="{StaticResource PrimaryGreenButton}"
                                    Command="{Binding ConfirmManualReleaseCommand}" />
                            <Button Content="Voltar"
                                    Style="{StaticResource QuietButton}"
                                    Command="{Binding BackToDashboardCommand}"
                                    Margin="12,0,0,8" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#0B0B0B" Padding="24,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Screen}" Value="AttendantLogin">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Screen}" Value="AttendantDashboard">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Screen}" Value="MemberSearch">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Screen}" Value="Enrollment">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <TextBlock Text="{Binding TurnstileStatusText}"
                           Style="{StaticResource MutedText}"
                           HorizontalAlignment="Left" />
                <TextBlock Text="{Binding LastSyncText}"
                           Style="{StaticResource MutedText}"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- ============ DASHBOARD ATENDENTE ============ -->
        <Grid Grid.RowSpan="3" Panel.ZIndex="3" Background="#0A0A0A">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Screen}" Value="AttendantDashboard">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="16">
                <StackPanel Width="400">
                        <Border Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="16" Padding="18,16" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Image Source="pack://application:,,,/Assets/logo-fht-acesso.png"
                                           Height="36" Stretch="Uniform" HorizontalAlignment="Left"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="Dashboard" FontSize="16" FontWeight="SemiBold" Foreground="White" TextAlignment="Right" />
                                        <TextBlock Text="Visão geral do sistema" FontSize="11" Foreground="#9A9A9A" TextAlignment="Right" />
                                    </StackPanel>
                                </Grid>

                                <Grid Height="44">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="16" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8F1;" FontSize="16" Foreground="#22C55E" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" Text="Catraca" Foreground="White" FontSize="13.5" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding TurnstileValue}" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#9A9A9A" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TurnstileOk}" Value="True">
                                                        <Setter Property="Foreground" Value="#22C55E" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Ellipse Grid.Column="3" Width="8" Height="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#6B7280" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TurnstileOk}" Value="True">
                                                        <Setter Property="Fill" Value="#22C55E" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Grid>
                                <Rectangle Height="1" Fill="#2A2A2A" />

                                <Grid Height="44">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="16" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE722;" FontSize="16" Foreground="#C8C8C8" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Câmera" Foreground="White" FontSize="13.5" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding CameraValue}" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#9A9A9A" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CameraOk}" Value="True">
                                                        <Setter Property="Foreground" Value="#22C55E" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Ellipse Grid.Column="3" Width="8" Height="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#6B7280" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CameraOk}" Value="True">
                                                        <Setter Property="Fill" Value="#22C55E" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Grid>
                                <Rectangle Height="1" Fill="#2A2A2A" />

                                <Grid Height="44">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="16" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" FontSize="16" Foreground="#C8C8C8" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="FHT Gestão" Foreground="White" FontSize="13.5" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding GestaoValue}" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#9A9A9A" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GestaoOk}" Value="True">
                                                        <Setter Property="Foreground" Value="#22C55E" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Ellipse Grid.Column="3" Width="8" Height="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#6B7280" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GestaoOk}" Value="True">
                                                        <Setter Property="Fill" Value="#22C55E" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Grid>
                                <Rectangle Height="1" Fill="#2A2A2A" />

                                <Grid Height="44">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="16" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE121;" FontSize="16" Foreground="#C8C8C8" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Última sincronização" Foreground="White" FontSize="13.5" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding LastSyncValue}" Foreground="White" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Ellipse Grid.Column="3" Width="8" Height="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#6B7280" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LastSyncOk}" Value="True">
                                                        <Setter Property="Fill" Value="#22C55E" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Grid>
                                <Rectangle Height="1" Fill="#2A2A2A" />

                                <Grid Height="44">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="16" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE783;" FontSize="16" Foreground="#F15A29" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Eventos pendentes" Foreground="White" FontSize="13.5" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding PendingEventsCount}" Foreground="#F15A29" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Ellipse Grid.Column="3" Width="8" Height="8" Fill="#F15A29" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource DashActionButton}" Command="{Binding GoEnrollCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8FA;" FontSize="16" Foreground="White" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Cadastrar facial" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" FontFamily="Segoe MDL2 Assets" Text="&#xE76C;" FontSize="12" Foreground="#A7F3D0" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource DashActionButton}" Command="{Binding GoSearchCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="16" Foreground="White" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Buscar aluno" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" FontFamily="Segoe MDL2 Assets" Text="&#xE76C;" FontSize="12" Foreground="#A7F3D0" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource DashActionButton}" Command="{Binding GoManualReleaseCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE89F;" FontSize="16" Foreground="White" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Liberação manual" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" FontFamily="Segoe MDL2 Assets" Text="&#xE76C;" FontSize="12" Foreground="#A7F3D0" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource DashActionButton}" Command="{Binding OpenSettingsCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="16" Foreground="White" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Configurações" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" FontFamily="Segoe MDL2 Assets" Text="&#xE76C;" FontSize="12" Foreground="#A7F3D0" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </Button>

                        <Button Command="{Binding EndAttendanceCommand}" Height="52" Margin="0,6,0,0" Cursor="Hand" HorizontalContentAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#0B0B0B" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="12" Padding="16,0">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="BorderBrush" Value="#6B7280" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7E8;" FontSize="16" Foreground="#C8C8C8" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Sair do modo atendente" FontSize="15" FontWeight="SemiBold" Foreground="#E5E5E5" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" FontFamily="Segoe MDL2 Assets" Text="&#xE76C;" FontSize="12" Foreground="#9A9A9A" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </Button>
                    </StackPanel>
            </Viewbox>
        </Grid>

        <!-- ============ BUSCAR ALUNO ============ -->
        <Grid Grid.RowSpan="3" Panel.ZIndex="3" Background="#0A0A0A">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Screen}" Value="MemberSearch">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Viewbox Stretch="Uniform" StretchDirection="Both" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="20,18,20,16">
                <Grid Width="400" Height="680">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="16" Padding="18,16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,14">
                                <Image Source="pack://application:,,,/Assets/logo-fht-acesso.png"
                                       Height="36" Stretch="Uniform" HorizontalAlignment="Left"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Buscar aluno" FontSize="16" FontWeight="SemiBold" Foreground="White" TextAlignment="Right" />
                                    <TextBlock Text="Encontre alunos por nome, CPF ou matrícula" FontSize="11" Foreground="#9A9A9A" TextAlignment="Right" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Border Background="#0F0F0F" BorderBrush="#22C55E" BorderThickness="1.5" CornerRadius="12" Height="46">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70D;" FontSize="14" Foreground="#22C55E"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Grid Grid.Column="1">
                                            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="White"
                                                     CaretBrush="White"
                                                     FontSize="14"
                                                     VerticalContentAlignment="Center"
                                                     Padding="0,0,8,0"
                                                     KeyDown="SearchField_KeyDown" />
                                            <TextBlock Text="Nome, CPF ou matrícula"
                                                       Foreground="#6B6B6B"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <Button Grid.Column="2"
                                                Command="{Binding ClearSearchCommand}"
                                                Cursor="Hand"
                                                Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolToVis}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="12" Foreground="#9A9A9A"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,0,0,12">
                                <Border Background="#0C0C0C" CornerRadius="12" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="96" Height="118" CornerRadius="12" ClipToBounds="True" Background="#1A1A1A" VerticalAlignment="Top">
                                            <Grid>
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" FontSize="36" Foreground="#4B5563"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding PreviewHasPhoto, Converter={StaticResource InvBoolToVis}}" />
                                                <Image Source="{Binding PreviewPhotoUrl}" Stretch="UniformToFill"
                                                       Visibility="{Binding PreviewHasPhoto, Converter={StaticResource BoolToVis}}"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" FontSize="13" Foreground="#22C55E" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding PreviewName}" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8FA;" FontSize="12" Foreground="#9A9A9A" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="CPF:" FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding PreviewCpf}" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7C1;" FontSize="12" Foreground="#9A9A9A" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="Plano:" FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding PreviewPlan}" FontSize="13" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#6B6B6B" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PreviewPlanOk}" Value="True">
                                                                    <Setter Property="Foreground" Value="#22C55E" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B8;" FontSize="12" Foreground="#9A9A9A" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="Facial:" FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding PreviewFace}" FontSize="13" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#6B6B6B" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PreviewHasFace}" Value="True">
                                                                    <Setter Property="Foreground" Value="#22C55E" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE787;" FontSize="12" Foreground="#9A9A9A" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="Matrícula:" FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding PreviewRegistration}" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Button Grid.Row="3" Margin="0,0,0,10"
                                    IsEnabled="{Binding HasPickedMember}"
                                    Click="SelectMember_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource DashActionButton}">
                                        <Setter Property="Opacity" Value="1" />
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.38" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Grid Width="22" Height="22" Margin="0,0,8,0">
                                        <Ellipse Fill="White" />
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="11" Foreground="#145C38"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="Selecionar" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="4" Command="{Binding SkipMemberCommand}" Cursor="Hand" Margin="0,0,0,8"
                                    Visibility="{Binding ShowSkipMember, Converter={StaticResource BoolToVis}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock Text="Liberar sem identificar" FontSize="12.5" Foreground="#9A9A9A" TextAlignment="Center" />
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <StackPanel Grid.Row="5">
                                <Grid Margin="0,4,0,10">
                                    <Border Height="1" Background="#2A2A2A" VerticalAlignment="Center" />
                                    <TextBlock Text="DICAS" FontSize="10" FontWeight="Bold" Foreground="#22C55E"
                                               Background="#141414" HorizontalAlignment="Center" Padding="10,0" />
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="18" Height="18" Margin="0,1,8,0" VerticalAlignment="Top">
                                        <Ellipse Stroke="#22C55E" StrokeThickness="1.4" />
                                        <TextBlock Text="i" FontSize="11" FontWeight="Bold" Foreground="#22C55E"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="Digite para filtrar e escolha o aluno no menu. As informações serão preenchidas automaticamente."
                                               FontSize="11.5" Foreground="#9A9A9A" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Dropdown sob o campo de busca — não cobre o botão Selecionar -->
                            <Border Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Top" Margin="0,50,0,0" Panel.ZIndex="30"
                                    Visibility="{Binding IsSearchDropdownOpen, Converter={StaticResource BoolToVis}}"
                                    Background="#101010" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="12"
                                    MaxHeight="180" Padding="4">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding SearchStatus}" FontSize="11" Foreground="#9A9A9A"
                                               Margin="10,6,10,4"
                                               Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVis}}" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                    <ItemsControl ItemsSource="{Binding Results}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Cursor="Hand"
                                                        Padding="10,8" Margin="2"
                                                        Click="PickSearchResult_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Row" Property="Background" Value="#1B7A4A" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding FaceLabel}" FontSize="11" Foreground="#A0A0A0" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" FontFamily="Segoe MDL2 Assets" Text="&#xE76C;" FontSize="11" Foreground="#86EFAC" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Button Grid.Row="1" Command="{Binding BackToDashboardCommand}" Height="52" Cursor="Hand" HorizontalContentAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="#0B0B0B" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="12" Padding="16,0">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="BorderBrush" Value="#6B7280" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72B;" FontSize="16" Foreground="#C8C8C8" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Voltar ao dashboard" FontSize="15" FontWeight="SemiBold" Foreground="#E5E5E5" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </Grid>
            </Viewbox>
        </Grid>

        <!-- ============ CADASTRO FACIAL ============ -->
        <Grid Grid.RowSpan="3" Panel.ZIndex="3" Background="#0A0A0A">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Screen}" Value="Enrollment">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Viewbox Stretch="Uniform" StretchDirection="Both" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="20,18,20,16">
                <Grid Width="400" Height="680">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="D. CADASTRO FACIAL" FontSize="15" FontWeight="Bold" Foreground="White"
                               Margin="2,0,0,12" />
                    <Border Grid.Row="1" Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="16" Padding="18,16" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Image Source="pack://application:,,,/Assets/logo-fht-acesso.png"
                                       Height="36" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="Cadastro facial" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                        <Ellipse Width="5" Height="5" Fill="#22C55E" Margin="8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedMemberName}" FontSize="14" Foreground="#9A9A9A" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Posicione o rosto no centro" FontSize="11" Foreground="#9A9A9A" TextAlignment="Right" />
                                </StackPanel>
                            </Grid>

                            <!-- Preview 16:9 — mesma proporção/orientação da webcam (sem espelho). -->
                            <Grid Width="520" Height="292" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Border Background="#0C0C0C" CornerRadius="10" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE714;" FontSize="48" Foreground="#3F3F3F"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding EnrollmentReady, Converter={StaticResource InvBoolToVis}}" />
                                        <Image Source="{Binding EnrollPreview}" Stretch="UniformToFill"
                                               Visibility="{Binding EnrollmentReady, Converter={StaticResource BoolToVis}}"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                </Border>
                                <Ellipse Width="150" Height="150" Stroke="#6B6B6B" StrokeThickness="1.2" Opacity="0.55"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <Path Stroke="#22C55E" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 14,52 L 14,14 L 52,14" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" />
                                <Path Stroke="#22C55E" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 0,52 L 0,14 L 38,14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <ScaleTransform ScaleX="-1" />
                                    </Path.RenderTransform>
                                </Path>
                                <Path Stroke="#22C55E" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 14,0 L 14,38 L 52,38" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" />
                                <Path Stroke="#22C55E" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 0,0 L 0,38 L 38,38" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <ScaleTransform ScaleX="-1" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>

                            <StackPanel Margin="4,0,4,0">
                                <StackPanel Orientation="Horizontal" Margin="0,8">
                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#3F3F3F" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EnrollmentReady}" Value="True">
                                                        <Setter Property="Fill" Value="#22C55E" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="Rosto detectado" FontSize="13.5" Foreground="#E5E5E5" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Height="1" Background="#2A2A2A" />
                                <StackPanel Orientation="Horizontal" Margin="0,8">
                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#3F3F3F" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EnrollmentReady}" Value="True">
                                                        <Setter Property="Fill" Value="#22C55E" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="Iluminação adequada" FontSize="13.5" Foreground="#E5E5E5" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Height="1" Background="#2A2A2A" />
                                <StackPanel Orientation="Horizontal" Margin="0,8">
                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#3F3F3F" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EnrollmentReady}" Value="True">
                                                        <Setter Property="Fill" Value="#22C55E" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="Qualidade ótima" FontSize="13.5" Foreground="#E5E5E5" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="{Binding EnrollStatus}" FontSize="13" Foreground="#E5E5E5"
                                       Margin="4,8,4,0" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2">
                        <Button Style="{StaticResource DashActionButton}" Command="{Binding CaptureCommand}" Margin="0,0,0,10" Height="52">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE722;" FontSize="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Capturar" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Olhe para a câmera e toque em Capturar."
                                   FontSize="13" Foreground="#9A9A9A" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Margin="8,0,8,10" />
                        <Button Command="{Binding BackToDashboardCommand}" Height="52" Cursor="Hand" HorizontalContentAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#0B0B0B" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="12" Padding="16,0">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="BorderBrush" Value="#6B7280" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72B;" FontSize="16" Foreground="#C8C8C8" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Voltar ao dashboard" FontSize="15" FontWeight="SemiBold" Foreground="#E5E5E5" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Viewbox>
        </Grid>

        <!-- ============ LOGIN DO ATENDENTE ============ -->
        <Grid Grid.RowSpan="3" Panel.ZIndex="4">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Screen}" Value="AttendantLogin">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Image Source="pack://application:,,,/Assets/propaganda-idle.png"
                   Stretch="UniformToFill"
                   Opacity="0.45"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                    <BlurEffect Radius="22" />
                </Image.Effect>
            </Image>
            <Rectangle Fill="#E60A0A0A" />

            <Border Margin="16" CornerRadius="28" Padding="1.6"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#22C55E" Offset="0" />
                        <GradientStop Color="#F15A29" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border Background="#0B0B0B" CornerRadius="26.5" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                            <StackPanel MaxWidth="400"
                                        Margin="28,16"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/logo-fht-acesso.png"
                                       Height="56"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="A C E S S O"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,22" />

                                <Border Background="#141414"
                                        BorderBrush="#2A2A2A"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="22,20">
                                    <StackPanel>
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   Text="&#xE77B;"
                                                   FontSize="28"
                                                   Foreground="#F15A29"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="LOGIN DO ATENDENTE"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,8,0,4" />
                                        <TextBlock Text="Acesse o sistema com suas credenciais"
                                                   FontSize="12"
                                                   Foreground="#9A9A9A"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,18" />

                                        <TextBlock Text="USUÁRIO"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#9A9A9A"
                                                   Margin="2,0,0,6" />
                                        <Border Background="#0F0F0F"
                                                BorderBrush="#333333"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Height="46"
                                                Margin="0,0,0,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           Text="&#xE77B;"
                                                           FontSize="16"
                                                           Foreground="#F15A29"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Grid Grid.Column="1">
                                                    <TextBox x:Name="UserBox"
                                                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             Foreground="White"
                                                             CaretBrush="White"
                                                             FontSize="14"
                                                             VerticalContentAlignment="Center"
                                                             Padding="0,0,12,0"
                                                             KeyDown="LoginField_KeyDown" />
                                                    <TextBlock Text="Digite seu usuário"
                                                               Foreground="#6B6B6B"
                                                               FontSize="14"
                                                               VerticalAlignment="Center"
                                                               IsHitTestVisible="False">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Username}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Username}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="SENHA"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#9A9A9A"
                                                   Margin="2,0,0,6" />
                                        <Border Background="#0F0F0F"
                                                BorderBrush="#333333"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Height="46"
                                                Margin="0,0,0,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="44" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           Text="&#xE72E;"
                                                           FontSize="16"
                                                           Foreground="#F15A29"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Grid Grid.Column="1">
                                                    <PasswordBox x:Name="PinBox"
                                                                 Background="Transparent"
                                                                 BorderThickness="0"
                                                                 Foreground="White"
                                                                 CaretBrush="White"
                                                                 FontSize="14"
                                                                 VerticalContentAlignment="Center"
                                                                 PasswordChanged="PinBox_PasswordChanged"
                                                                 KeyDown="LoginField_KeyDown"
                                                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource InvBoolToVis}}" />
                                                    <TextBox x:Name="PinRevealBox"
                                                             Text="{Binding Pin, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             Foreground="White"
                                                             CaretBrush="White"
                                                             FontSize="14"
                                                             VerticalContentAlignment="Center"
                                                             KeyDown="LoginField_KeyDown"
                                                             Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="Digite sua senha"
                                                               Foreground="#6B6B6B"
                                                               FontSize="14"
                                                               VerticalAlignment="Center"
                                                               IsHitTestVisible="False">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Pin}" Value="" />
                                                                            <Condition Binding="{Binding IsPasswordVisible}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Pin}" Value="" />
                                                                            <Condition Binding="{Binding IsPasswordVisible}" Value="True" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <Button Grid.Column="2"
                                                        Command="{Binding TogglePasswordVisibilityCommand}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Click="TogglePassword_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="16"
                                                                       Foreground="#9A9A9A"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Text="&#xE890;" />
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="{Binding LoginError}"
                                                   Foreground="#F15A29"
                                                   FontSize="12.5"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"
                                                   MinHeight="18" />

                                        <Button Command="{Binding LoginCommand}"
                                                Height="48"
                                                Cursor="Hand"
                                                HorizontalAlignment="Stretch">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" CornerRadius="10" Padding="16,0">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#16A34A" Offset="0" />
                                                                <GradientStop Color="#22C55E" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                                       Text="&#xE8A7;"
                                                                       FontSize="16"
                                                                       Foreground="White"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,10,0" />
                                                            <TextBlock Text="ENTRAR"
                                                                       FontSize="15"
                                                                       FontWeight="Bold"
                                                                       Foreground="White"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Opacity" Value="0.92" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Button Margin="0,12,0,0"
                                                Height="44"
                                                Cursor="Hand"
                                                HorizontalContentAlignment="Stretch"
                                                Command="{Binding ReturnToKioskCommand}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg"
                                                            Background="#161616"
                                                            BorderBrush="#333333"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="16,0">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                                       Text="&#xE72B;"
                                                                       FontSize="15"
                                                                       Foreground="#C8C8C8"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,10,0" />
                                                            <TextBlock Text="VOLTAR AO MODO ALUNO"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#E5E5E5"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="BorderBrush" Value="#F15A29" />
                                                            <Setter TargetName="Bg" Property="Background" Value="#1C1C1C" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,22,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B8;" FontSize="20"
                                                   Foreground="#22C55E" HorizontalAlignment="Center" />
                                        <TextBlock Text="RECONHECIMENTO AUTOMÁTICO" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="White" TextAlignment="Center" TextWrapping="Wrap"
                                                   Margin="4,8,4,0" />
                                    </StackPanel>
                                    <Rectangle Grid.Column="1" Width="1" Fill="#333333" Margin="4,4" />
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEA18;" FontSize="20"
                                                   Foreground="#F15A29" HorizontalAlignment="Center" />
                                        <TextBlock Text="ACESSO SEGURO" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="White" TextAlignment="Center" TextWrapping="Wrap"
                                                   Margin="4,8,4,0" />
                                    </StackPanel>
                                    <Rectangle Grid.Column="3" Width="1" Fill="#333333" Margin="4,4" />
                                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE121;" FontSize="20"
                                                   Foreground="#22C55E" HorizontalAlignment="Center" />
                                        <TextBlock Text="CONTROLE EM TEMPO REAL" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="White" TextAlignment="Center" TextWrapping="Wrap"
                                                   Margin="4,8,4,0" />
                                    </StackPanel>
                                    <Rectangle Grid.Column="5" Width="1" Fill="#333333" Margin="4,4" />
                                    <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D2;" FontSize="20"
                                                   Foreground="#F15A29" HorizontalAlignment="Center" />
                                        <TextBlock Text="GESTÃO INTELIGENTE" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="White" TextAlignment="Center" TextWrapping="Wrap"
                                                   Margin="4,8,4,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <TextBlock Grid.Row="1"
                                   HorizontalAlignment="Center"
                                   FontSize="11"
                                   Foreground="#8A8A8A"
                                   Margin="16,4,16,16"
                                   TextAlignment="Center">
                            <Run Text="FHT Acesso" Foreground="#C8C8C8" FontWeight="SemiBold" />
                            <Run Text="  •  Tecnologia que conecta, gestão que transforma." />
                        </TextBlock>
                    </Grid>
                </Border>
            </Border>
        </Grid>

        <!-- Configurações (AdminShellView) overlay -->
        <Grid Grid.RowSpan="3"
              Panel.ZIndex="20"
              Background="#000000"
              Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <views:AdminShellView Grid.Row="0" DataContext="{Binding AdminViewModel}" />
            <Button Grid.Row="1"
                    Content="Voltar ao atendimento"
                    Style="{StaticResource QuietButton}"
                    Command="{Binding CloseSettingsCommand}"
                    HorizontalAlignment="Right"
                    Margin="0,0,24,16" />
        </Grid>

        <!-- Idle warning overlay -->
        <Grid Grid.RowSpan="3"
              Panel.ZIndex="21"
              Background="#CC000000"
              Visibility="{Binding IsIdleWarningVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#141414"
                    BorderBrush="#F15A29"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="36,28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Sessão ociosa"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="O atendimento será encerrado e o modo automático voltará em instantes."
                               Style="{StaticResource MutedText}"
                               TextAlignment="Center"
                               Margin="0,10,0,22" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Continuar atendendo"
                                Style="{StaticResource PrimaryGreenButton}"
                                Command="{Binding ContinueAttendingCommand}" />
                        <Button Content="Encerrar agora"
                                Style="{StaticResource QuietButton}"
                                Command="{Binding EndAttendanceCommand}"
                                Margin="12,0,0,8" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
