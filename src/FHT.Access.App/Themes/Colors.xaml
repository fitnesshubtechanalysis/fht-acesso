<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BackgroundColor">#000000</Color>
    <Color x:Key="FhtOrangeColor">#F15A29</Color>
    <Color x:Key="FhtPetrolColor">#1F5F5B</Color>
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextMutedColor">#9A9A9A</Color>
    <Color x:Key="SurfaceColor">#121212</Color>
    <Color x:Key="BorderSubtleColor">#2A2A2A</Color>
    <Color x:Key="DeniedColor">#B84A3A</Color>
    <Color x:Key="AllowedColor">#2E7A6B</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="FhtOrangeBrush" Color="{StaticResource FhtOrangeColor}" />
    <SolidColorBrush x:Key="FhtPetrolBrush" Color="{StaticResource FhtPetrolColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="DeniedBrush" Color="{StaticResource DeniedColor}" />
    <SolidColorBrush x:Key="AllowedBrush" Color="{StaticResource AllowedColor}" />
</ResourceDictionary>
